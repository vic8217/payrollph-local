{
  "name": "PayrollRecord",
  "type": "object",
  "properties": {
    "company_profile_id": {
      "type": "string",
      "description": "Reference to the company this payroll record belongs to"
    },
    "payroll_period_id": {
      "type": "string"
    },
    "period_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "regular",
        "probationary",
        "contractual",
        "part_time",
        "agency"
      ]
    },
    "days_worked": {
      "type": "number"
    },
    "regular_days": {
      "type": "number"
    },
    "rest_day_worked": {
      "type": "number"
    },
    "regular_holiday_worked": {
      "type": "number"
    },
    "special_holiday_worked": {
      "type": "number"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "late_deduction": {
      "type": "number",
      "default": 0
    },
    "undertime_deduction": {
      "type": "number",
      "default": 0
    },
    "absent_deduction": {
      "type": "number",
      "default": 0
    },
    "basic_pay": {
      "type": "number"
    },
    "overtime_pay": {
      "type": "number",
      "default": 0
    },
    "holiday_pay": {
      "type": "number",
      "default": 0
    },
    "gross_pay": {
      "type": "number"
    },
    "sss_contribution": {
      "type": "number"
    },
    "philhealth_contribution": {
      "type": "number"
    },
    "pagibig_contribution": {
      "type": "number"
    },
    "withholding_tax": {
      "type": "number",
      "default": 0
    },
    "agency_fee": {
      "type": "number",
      "default": 0,
      "description": "Agency fee deduction (for agency employees)"
    },
    "cash_advance_deduction": {
      "type": "number",
      "default": 0
    },
    "total_deductions": {
      "type": "number"
    },
    "net_pay": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "released"
      ],
      "default": "draft"
    }
  },
  "required": [
    "payroll_period_id",
    "employee_id"
  ]
}
{
  "name": "CompanyProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Official registered company name"
    },
    "trade_name": {
      "type": "string",
      "description": "Trade name / DBA (Doing Business As)"
    },
    "subdomain": {
      "type": "string",
      "description": "Unique subdomain for this company (e.g. company1, company2)"
    },
    "address": {
      "type": "string",
      "description": "Complete business address"
    },
    "sss_employer_number": {
      "type": "string",
      "description": "SSS Employer Registration Number"
    },
    "philhealth_employer_number": {
      "type": "string",
      "description": "PhilHealth Employer Number"
    },
    "pagibig_employer_number": {
      "type": "string",
      "description": "Pag-IBIG Employer ID Number"
    },
    "tin_number": {
      "type": "string",
      "description": "Tax Identification Number (TIN)"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo URL"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "company_name"
  ]
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "user"
      ],
      "default": "user",
      "description": "super_admin = all access; admin = all except passcode & user management; user = HR officer level (no passcode/user mgmt)"
    },
    "company_profile_id": {
      "type": "string",
      "description": "Restrict this user to a specific company. If empty, user sees all companies."
    }
  }
}
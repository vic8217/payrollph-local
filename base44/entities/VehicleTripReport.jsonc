{
  "name": "VehicleTripReport",
  "type": "object",
  "properties": {
    "company_profile_id": {
      "type": "string",
      "description": "Reference to the company this trip report belongs to"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "start_odometer": {
      "type": "number"
    },
    "end_odometer": {
      "type": "number"
    },
    "trip_budget": {
      "type": "number",
      "default": 0,
      "description": "Allocated budget for the trip"
    },
    "driver_name": {
      "type": "string",
      "description": "Name of the driver"
    },
    "crew_names": {
      "type": "string",
      "description": "Comma-separated names of crew/passengers"
    },
    "trips": {
      "type": "array",
      "description": "List of trip legs",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "departure_time": {
            "type": "string"
          },
          "arrival_time": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "expenses": {
      "type": "array",
      "description": "Trip liquidation expenses",
      "items": {
        "type": "object",
        "properties": {
          "expense_type": {
            "type": "string",
            "enum": [
              "rfid",
              "fuel",
              "toll",
              "traffic_violation",
              "food"
            ]
          },
          "amount": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_expenses": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "report_date"
  ]
}
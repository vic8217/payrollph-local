{
  "name": "PayrollPeriod",
  "type": "object",
  "properties": {
    "company_profile_id": {
      "type": "string",
      "description": "Reference to the company this payroll period belongs to"
    },
    "period_name": {
      "type": "string",
      "description": "e.g. Week 1 - April 2026"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "processing",
        "approved",
        "released"
      ],
      "default": "draft"
    },
    "total_gross": {
      "type": "number"
    },
    "total_deductions": {
      "type": "number"
    },
    "total_net": {
      "type": "number"
    },
    "employee_count": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "period_name",
    "start_date",
    "end_date"
  ]
}
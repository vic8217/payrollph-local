{
  "name": "CompanyPolicy",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Policy title"
    },
    "category": {
      "type": "string",
      "enum": [
        "hr",
        "attendance",
        "payroll",
        "conduct",
        "safety",
        "it",
        "other"
      ],
      "default": "hr"
    },
    "content": {
      "type": "string",
      "description": "Full policy content / body text"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "content"
  ]
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String?
  activeSessionId        String?
  activeSessionExpiresAt DateTime?
  role                   String    @default("user")
  approvalStatus         String    @default("approved")
  companyProfileId       String?
  accessSchedule         Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  passwordResetTokens    PasswordResetToken[]
  accessLogs             UserAccessLog[]
  faceProfile            UserFaceProfile?
  faceVerificationLogs   UserFaceVerificationLog[]
  faceVerificationChallenges UserFaceVerificationChallenge[]
  reviewerNotesCreated PayrollReconciliationReviewerNote[] @relation("ReviewerNoteCreatedBy")
  reviewerNotesResponded PayrollReconciliationReviewerNote[] @relation("ReviewerNoteRespondedBy")
  reviewerNotesResolved PayrollReconciliationReviewerNote[] @relation("ReviewerNoteResolvedBy")
  reviewerNoteEvents PayrollReconciliationReviewerNoteEvent[] @relation("ReviewerNoteEventActor")
  dailyVarianceNotesCreated PayrollReconciliationDailyVarianceNote[] @relation("DailyVarianceNoteCreatedBy")
  dailyVarianceNotesUpdated PayrollReconciliationDailyVarianceNote[] @relation("DailyVarianceNoteUpdatedBy")
}

model EntityRecord {
  id        String   @id @default(cuid())
  entity    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entity])
}

// Reviewer questions and their workflow history are intentionally separate from
// the generic PayrollReconciliation JSON payload. Foreign keys remain logical
// IDs because payroll entities are stored in EntityRecord.
model PayrollReconciliationReviewerNote {
  id                  String   @id @default(cuid())
  companyProfileId    String
  payrollPeriodId     String
  employeeId          String
  reconciliationId    String?
  category            String
  reviewerNote        String
  status              String   @default("needs_response")
  createdByUserId     String
  createdAt           DateTime @default(now())
  response            String?
  respondedByUserId   String?
  respondedAt         DateTime?
  resolutionNote      String?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  updatedAt           DateTime @updatedAt
  createdBy           AppUser  @relation("ReviewerNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  respondedBy         AppUser? @relation("ReviewerNoteRespondedBy", fields: [respondedByUserId], references: [id], onDelete: Restrict)
  resolvedBy          AppUser? @relation("ReviewerNoteResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  events              PayrollReconciliationReviewerNoteEvent[]

  @@index([companyProfileId, payrollPeriodId], map: "ReviewerNote_company_period_idx")
  @@index([companyProfileId, payrollPeriodId, status], map: "ReviewerNote_company_period_status_idx")
  @@index([companyProfileId, employeeId, payrollPeriodId], map: "ReviewerNote_company_employee_period_idx")
  @@index([employeeId, payrollPeriodId])
  @@index([status])
  @@index([reconciliationId])
}

model PayrollReconciliationReviewerNoteEvent {
  id                      String   @id @default(cuid())
  noteId                  String
  eventType               String
  previousStatus          String?
  newStatus               String?
  remarks                 String?
  actorUserId             String
  actorRole               String
  snapshotCategory        String?
  snapshotSystemValue     Decimal? @db.Decimal(18, 4)
  snapshotManualValue     Decimal? @db.Decimal(18, 4)
  snapshotDifferenceValue Decimal? @db.Decimal(18, 4)
  snapshotValueType       String?
  createdAt               DateTime @default(now())
  note                    PayrollReconciliationReviewerNote @relation(fields: [noteId], references: [id], onDelete: Restrict)
  actor                   AppUser @relation("ReviewerNoteEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([noteId, createdAt])
  @@index([actorUserId])
}

model PayrollReconciliationDailyVarianceNote {
  id                String   @id @default(cuid())
  companyProfileId  String
  payrollPeriodId   String
  employeeId        String
  attendanceDate    DateTime @db.Date
  note              String
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedByUserId   String?
  updatedAt         DateTime @updatedAt
  createdBy         AppUser  @relation("DailyVarianceNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy         AppUser? @relation("DailyVarianceNoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyProfileId, payrollPeriodId, employeeId, attendanceDate], map: "DailyVarianceNote_company_period_employee_date_key")
  @@index([companyProfileId, payrollPeriodId, employeeId], map: "DailyVarianceNote_company_period_employee_idx")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserAccessLog {
  id         String   @id @default(cuid())
  userId     String
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  role       String
  eventType  String
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([occurredAt])
}

model UserFaceProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfileId       String?
  encryptedReferenceImage String?
  encryptedEmbedding     String
  referenceImageIv       String?
  referenceImageAuthTag  String?
  embeddingIv            String
  embeddingAuthTag       String
  status                 String   @default("active")
  consentAt              DateTime
  enrolledAt             DateTime @default(now())
  enrolledByUserId       String?
  enrolledByUserEmail    String?
  revokedAt              DateTime?
  revokedByUserId        String?
  auditLog               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyProfileId])
  @@index([status])
}

model UserFaceVerificationLog {
  id                     String   @id @default(cuid())
  userId                 String
  user                   AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfileId       String?
  userFaceProfileId      String?
  purpose                String
  result                 String
  similarityScore        Float?
  livenessResult         String
  livenessMessage        String?
  deviceUserAgent        String?
  ipAddress              String?
  requestedByUserEmail   String?
  auditLog               Json?
  createdAt              DateTime @default(now())

  @@index([userId])
  @@index([companyProfileId])
  @@index([result])
  @@index([purpose])
  @@index([createdAt])
}

model UserFaceVerificationChallenge {
  id            String    @id @default(cuid())
  userId         String
  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfileId String?
  purpose        String
  nonceHash      String
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  deviceUserAgent String?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model EmployeeFaceProfile {
  id                      String   @id @default(cuid())
  companyProfileId        String?
  employeeRecordId        String?
  employeeId              String
  employeeName            String?
  encryptedReferenceImage String
  encryptedTemplate       String
  referenceImageIv        String
  referenceImageAuthTag   String
  templateIv              String
  templateAuthTag         String
  status                  String   @default("active")
  consentAt               DateTime
  enrolledByUserId        String?
  enrolledByUserEmail     String?
  enrolledAt              DateTime @default(now())
  suspendedAt             DateTime?
  suspendedByUserId       String?
  revokedAt               DateTime?
  revokedByUserId         String?
  auditLog                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([companyProfileId])
  @@index([employeeId])
  @@index([status])
}

model EmployeeFaceVerificationLog {
  id                  String   @id @default(cuid())
  companyProfileId    String?
  employeeFaceProfileId String?
  employeeRecordId    String?
  employeeId          String
  employeeName        String?
  purpose             String
  result              String
  confidenceScore     Float?
  livenessResult      String
  livenessMessage     String?
  deviceUserAgent     String?
  ipAddress           String?
  encryptedPhotoEvidence String?
  photoEvidenceIv     String?
  photoEvidenceAuthTag String?
  requestedByUserId   String?
  requestedByUserEmail String?
  auditLog            Json?
  createdAt           DateTime @default(now())

  @@index([companyProfileId])
  @@index([employeeId])
  @@index([result])
  @@index([purpose])
  @@index([createdAt])
}

model FaceVerificationSetting {
  id                  String   @id @default(cuid())
  companyProfileId    String?  @unique
  enabled             Boolean  @default(false)
  storePhotoEvidence  Boolean  @default(false)
  minimumConfidence   Float    @default(0.82)
  updatedByUserId     String?
  updatedByUserEmail  String?
  auditLog            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyProfileId])
}

model BiometricDevice {
  id                     String   @id @default(cuid())
  // Phase 1: exactly one assigned company. companyProfileId is the active
  // tenant. BiometricDeviceCompany remains so a later release can authorize
  // more than one company on the same terminal without redesigning raw events.
  companyProfileId       String?
  deviceSerial           String   @unique
  cloudId                String?
  terminalType           String?
  productName            String?
  siteCode               String?
  siteName               String?
  registrationSecretHash String?
  status                 String   @default("pending")
  lastSeenAt             DateTime?
  lastLoginAt            DateTime?
  lastOnlineAt           DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  allowedCompanies       BiometricDeviceCompany[]
  userMappings           BiometricUserMapping[]
  timeLogs               BiometricTimeLog[]
  adminLogs              BiometricAdminLog[]
  auditEvents            BiometricAuditEvent[]

  @@index([companyProfileId])
  @@index([status])
  @@index([cloudId])
}

model BiometricDeviceCompany {
  id               String          @id @default(cuid())
  deviceId         String
  companyProfileId String
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  device           BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, companyProfileId])
  @@index([companyProfileId, status])
  @@index([deviceId, status])
}

model BiometricUserMapping {
  id               String          @id @default(cuid())
  companyProfileId String
  deviceId         String
  employeeRecordId String
  employeeId       String
  deviceUserId     String
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  device           BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // User IDs must be unique inside one physical terminal. The same PayrollPH
  // employee may later be mapped on another terminal for roaming/site access.
  @@unique([deviceId, deviceUserId])
  @@unique([deviceId, employeeRecordId])
  @@index([companyProfileId, employeeId])
  @@index([companyProfileId, status])
}

model BiometricTimeLog {
  id                     String          @id @default(cuid())
  // Null until the device UserID is resolved to a company-scoped employee map.
  // Quarantined / unmapped punches keep this null and never enter attendance.
  companyProfileId       String?
  deviceId               String
  deviceSerial           String
  logId                  String
  deviceUserId           String?
  occurredAt             DateTime?
  occurredAtLocal        String?
  utcTimezoneMinutes     Int?
  attendStatus           String?
  verifyMethod           String?
  verifyMethodNormalized String?
  jobCode                String?
  transId                String?
  rawPayload             Json
  payloadSanitized       Boolean         @default(true)
  discardedFieldNames    Json?
  ingestSource           String          @default("push")
  receivedAt             DateTime        @default(now())
  sourceIp               String?
  processingStatus       String          @default("received")
  employeeRecordId       String?
  employeeId             String?
  // Reserved for a later interpreter. Phase 1 must leave these null.
  attendanceLogId        String?
  mappedSlot             String?
  createdAt              DateTime        @default(now())
  device                 BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceSerial, logId])
  @@index([companyProfileId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([companyProfileId, deviceUserId, occurredAt])
  @@index([processingStatus])
  @@index([ingestSource])
}

model BiometricAuditEvent {
  id                 String          @id @default(cuid())
  occurredAt         DateTime        @default(now())
  actorType          String
  actorId            String?
  companyProfileId   String?
  deviceId           String?
  deviceSerial       String?
  eventType          String
  result             String
  reasonCode         String?
  biometricTimeLogId String?
  mappingId          String?
  details            Json?
  createdAt          DateTime        @default(now())
  device             BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId, occurredAt])
  @@index([companyProfileId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([result])
}

model BiometricAdminLog {
  id               String          @id @default(cuid())
  // Device administration events are site/device scoped; company may be null.
  companyProfileId String?
  deviceId         String
  deviceSerial     String
  logId            String
  adminId          String?
  deviceUserId     String?
  occurredAt       DateTime?
  occurredAtLocal  String?
  action           String?
  stat             String?
  transId          String?
  rawPayload       Json
  receivedAt       DateTime        @default(now())
  sourceIp         String?
  processingStatus String          @default("received")
  createdAt        DateTime        @default(now())
  device           BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([deviceSerial, logId])
  @@index([companyProfileId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([processingStatus])
}
